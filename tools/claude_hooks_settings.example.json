{
  "_comment": "Drop these blocks into ~/.claude/settings.json (or merge with existing hooks). Replace /ABS/PATH with the absolute path to claude_hook_post.py.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "/ABS/PATH/tools/claude_hook_post.py user_prompt" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "/ABS/PATH/tools/claude_hook_post.py pre_tool" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "/ABS/PATH/tools/claude_hook_post.py post_tool" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "/ABS/PATH/tools/claude_hook_post.py notification" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/ABS/PATH/tools/claude_hook_post.py stop" }
        ]
      }
    ]
  }
}
