{
  "_comment": "Recommended: run tools/install_claude_status_hooks.py on each computer. It installs ~/.local/bin/esp32-claude-hook and writes these global hooks without hard-coding the repository path here.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/esp32-claude-hook user_prompt" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/esp32-claude-hook pre_tool" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/esp32-claude-hook post_tool" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/esp32-claude-hook notification" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.local/bin/esp32-claude-hook stop" }
        ]
      }
    ]
  }
}
